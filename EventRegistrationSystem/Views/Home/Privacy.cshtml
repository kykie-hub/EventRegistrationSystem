@{
    ViewData["Title"] = "About";
}

<div class="container py-5">

    <div class="text-center">

        <h1 class="fw-bold">
            About Eventify
        </h1>

        <p class="lead mt-3">
            Eventify is a simple Event Registration Website developed
            using ASP.NET Core MVC. It helps organizers create,
            manage, and monitor events in one place.
        </p>

    </div>

    <div class="row mt-5">

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">

                    <i class="bi bi-lightbulb-fill"></i>

                </div>

                <h4>Easy</h4>

                <p>
                    Register school events in just a few clicks.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">

                    <i class="bi bi-shield-check"></i>

                </div>

                <h4>Reliable</h4>

                <p>
                    Organize event information efficiently.
                </p>

            </div>

        </div>

        <div class="col-md-4">

            <div class="feature-card">

                <div class="feature-icon">

                    <i class="bi bi-people-fill"></i>

                </div>

                <h4>Simple</h4>

                <p>
                    Designed for students and organizations.
                </p>

            </div>

        </div>

    </div>

</div>