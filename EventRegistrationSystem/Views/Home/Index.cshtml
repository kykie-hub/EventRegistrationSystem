@{
    ViewData["Title"] = "Home";
}

<section class="hero">

    <div class="container">

        <div class="row align-items-center">

            <div class="col-lg-6">

                <span class="badge bg-primary mb-3 px-3 py-2">
                    EVENT MANAGEMENT
                </span>

                <h1>
                    Plan, Register &<br />
                    Manage Events
                    <span class="text-primary">Effortlessly</span>
                </h1>

                <p>
                    Eventify helps students and organizations organize events,
                    register participants, and manage everything in one place.
                </p>

                <div class="mt-4">

                    <a asp-controller="Event"
                       asp-action="Create"
                       class="btn btn-primary btn-lg">

                        Register Event

                    </a>

                    <a asp-controller="Event"
                       asp-action="Index"
                       class="btn btn-outline-primary btn-lg ms-2">

                        View Events

                    </a>

                </div>

            </div>

            <div class="col-lg-6 text-center">

                <img src="~/images/event-hero.svg"
                     class="img-fluid"
                     alt="Event Illustration" />

            </div>

        </div>

    </div>

</section>

<section class="py-5">

    <div class="container">

        <h2 class="section-title">
            Everything You Need
        </h2>

        <div class="row g-4">

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-calendar-plus-fill"></i>
                    </div>

                    <h4>Register Event</h4>

                    <p>
                        Quickly create seminars,
                        meetings, workshops,
                        and school activities.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-card-list"></i>
                    </div>

                    <h4>Manage Events</h4>

                    <p>
                        View all registered
                        events in one organized
                        dashboard.
                    </p>

                </div>

            </div>

            <div class="col-md-4">

                <div class="feature-card">

                    <div class="feature-icon">
                        <i class="bi bi-people-fill"></i>
                    </div>

                    <h4>Participants</h4>

                    <p>
                        Monitor the number
                        of participants for
                        every event.
                    </p>

                </div>

            </div>

        </div>

    </div>

</section>